{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/saagpatel/Grotto/schemas/token-rates-v1.schema.json",
  "title": "Grotto User-Supplied Token Rates V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "as_of", "currency", "rates"],
  "properties": {
    "schema": {"const": "grotto.token_rates.v1"},
    "as_of": {"type": "string"},
    "currency": {"type": "string", "minLength": 1},
    "rates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "model", "per_million_tokens"],
        "properties": {
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "per_million_tokens": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "output"],
            "properties": {
              "input": {"type": "string", "pattern": "^(0|[0-9]+)(\\.[0-9]+)?$"},
              "output": {"type": "string", "pattern": "^(0|[0-9]+)(\\.[0-9]+)?$"},
              "cache_read_input": {"type": "string", "pattern": "^(0|[0-9]+)(\\.[0-9]+)?$"},
              "cache_write_input": {"type": "string", "pattern": "^(0|[0-9]+)(\\.[0-9]+)?$"},
              "reasoning_output": {"type": "string", "pattern": "^(0|[0-9]+)(\\.[0-9]+)?$"}
            }
          }
        }
      }
    }
  }
}

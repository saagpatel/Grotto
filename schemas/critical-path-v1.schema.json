{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/saagpatel/Grotto/schemas/critical-path-v1.schema.json",
  "title": "Grotto Critical Path V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "trace_id", "run_label", "source", "status", "spans", "metrics", "issues", "claim_ceiling"],
  "properties": {
    "schema": {"const": "grotto.critical_path.v1"},
    "trace_id": {"type": "string", "minLength": 1},
    "run_label": {"type": "string"},
    "source": {"type": "string"},
    "status": {"enum": ["ok", "no_edge", "missing", "cyclic", "malformed"]},
    "spans": {
      "type": "array",
      "items": {"$ref": "#/$defs/path_span"}
    },
    "metrics": {"$ref": "#/$defs/metrics"},
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "claim_ceiling": {
      "const": "longest-duration chain through stored cargo.unit/cargo.unblocks edges; no path is emitted for no-edge, missing, cyclic, or malformed graphs"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ok"}}},
      "then": {
        "properties": {
          "spans": {"minItems": 1},
          "metrics": {
            "properties": {
              "critical_ns": {"type": "integer", "minimum": 0}
            }
          }
        }
      },
      "else": {
        "properties": {
          "spans": {"maxItems": 0},
          "metrics": {
            "properties": {
              "critical_ns": {"type": "null"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "path_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "unit", "span_id", "name", "started_ns", "ended_ns", "duration_ns"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "unit": {"type": "integer", "minimum": 0},
        "span_id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "started_ns": {"type": "integer"},
        "ended_ns": {"type": "integer"},
        "duration_ns": {"type": "integer", "minimum": 0}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical_ns", "total_work_ns", "wall_clock_ns", "unit_count", "path_span_count", "edge_count"],
      "properties": {
        "critical_ns": {"type": ["integer", "null"], "minimum": 0},
        "total_work_ns": {"type": "integer", "minimum": 0},
        "wall_clock_ns": {"type": "integer"},
        "unit_count": {"type": "integer", "minimum": 0},
        "path_span_count": {"type": "integer", "minimum": 0},
        "edge_count": {"type": "integer", "minimum": 0}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "no_edge",
            "missing_unit",
            "cycle",
            "invalid_unit",
            "duplicate_unit",
            "invalid_unblocks",
            "unblocks_without_unit"
          ]
        },
        "span_id": {"type": "string"},
        "unit": {"type": "integer", "minimum": 0},
        "message": {"type": "string"}
      }
    }
  }
}
